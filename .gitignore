# Build output, caches, and virtual environments
# ---------------------------------------------------------------------
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
*.exe
*.pdb
*.dll
*.obj

