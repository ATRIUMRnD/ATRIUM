# ATRIUM holds only rules, routing, and roadmap documents, no code.
# The rooms (owned repos) and local tooling are checked out here but
# tracked in their own repositories, not this one.
/DUCTEI/
/LIMEN/
/Qallow/
/VEYN/
/dayroom0/

# Local scratch for smoke runs (DUCTEI scripts accept --workdir target/tmp)
/target/

# Staging area for deploy/smoke scripts, key material copies, and WIP patches
# (code and host-specific scripts live in the owning repos, not here)
/_t8_stage/
/router-candidates-staged-*.patch
/ROUTER-CANDIDATES-WIP-README.txt

# Private rooms and commercial notes (local only, never published)
/private/

# ---------------------------------------------------------------------
# Secrets and credentials (AGENTS.md: no hardcoded credentials, env vars only)
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
secrets/
*.secret
*.secrets
credentials*
# --- secrets and key material: never commit (security baseline) ---
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks
*.keystore
id_rsa*
id_ed25519*
id_ecdsa*
*.ppk
.ssh/
.gnupg/
.aws/
.azure/
.kube/
.npmrc
.pypirc
.netrc
.git-credentials
*token*.txt
*apikey*
*api_key*
# Post-quantum and sync identity material (QFLTL / ductei-sync)
*.seed
*.dpapi
identity.seed*
identity.pub
known_peers/
*.kyber
*.dilithium
*.mlkem
*.mldsa
*.authkey
*.ovpn

# ---------------------------------------------------------------------
# Node identity, runtime state, and machine fingerprints
# (daemon-owned; lamport counters and node identity must never be
# fabricated or shared, and logs/fingerprints can identify the host)
# ---------------------------------------------------------------------
/ductei-anchor-node/
*-fingerprint.txt
*fingerprint*
lamport
node_id
node-id
node.id
status.txt
witness.log
*.jsonl
spool/
*.lmdb
*.mdb
lock.mdb
data.mdb
*.db-shm
*.db-wal

# ---------------------------------------------------------------------
# Logs, dumps, traces, and captures (may contain hostnames, IPs, paths)
# ---------------------------------------------------------------------
*.log
logs/
*.dmp
*.mdmp
*.stackdump
*.pcap
*.pcapng
*.trace
*.etl
core
core.*
hs_err_pid*

# ---------------------------------------------------------------------
# Local tool, editor, and agent settings (contain user paths and history)
# ---------------------------------------------------------------------
.claude/
CLAUDE.local.md
.vscode/
.idea/
*.code-workspace.local
*.local.json
*.local.toml
*.local.yaml
*.local.yml
.history/
.vs/
*.suo
*.user
*.swp
*.swo
*~

